{
  "name": "label-release",
  "version": "0.1.0",
  "description": "Forgejo action that cuts a new release based on PR labels since the last release.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && ncc build .build/index.js -o dist --source-map --minify",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node --experimental-transform-types scripts/smoke.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@vercel/ncc": "^0.45.0",
    "prettier": "^3.8.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "yaml": "^2.8.3"
  }
}
